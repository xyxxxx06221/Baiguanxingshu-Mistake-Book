{
  "name": "baiguan-xingshu",
  "productName": "百官行述",
  "version": "0.1.0",
  "description": "本机优先的行测错题复盘与间隔复习工具",
  "license": "MIT",
  "homepage": "https://github.com/xyxxxx06221/Baiguanxingshu-Mistake-Book#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xyxxxx06221/Baiguanxingshu-Mistake-Book.git"
  },
  "bugs": {
    "url": "https://github.com/xyxxxx06221/Baiguanxingshu-Mistake-Book/issues"
  },
  "private": true,
  "main": "electron/main.mjs",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "vinext start",
    "test": "node --test --experimental-strip-types app/*.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "desktop": "pnpm run build && electron .",
    "desktop:bundle": "esbuild electron/main.mjs --bundle --platform=node --format=esm --target=node22 --external:electron --outfile=desktop/main.mjs",
    "desktop:pack": "pnpm run build && pnpm run desktop:bundle && node scripts/package-desktop.mjs",
    "desktop:dist": "pnpm run build && pnpm run desktop:bundle && node scripts/package-desktop.mjs --dmg"
  },
  "dependencies": {
    "next": "16.2.11",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.2.108",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "vinext": "1.0.0-beta.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@openai/sites-vite-plugin": "^0.1.0 || ^0.2.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.34",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "esbuild": "0.28.1",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.0.16",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "build": {
    "appId": "cn.baiguan.xingshu",
    "productName": "百官行述",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "dist",
        "to": "dist"
      }
    ],
    "mac": {
      "category": "public.app-category.education",
      "icon": "public/app-icon.png",
      "target": [
        "dir",
        "dmg"
      ]
    },
    "dmg": {
      "title": "百官行述 ${version}"
    }
  }
}
